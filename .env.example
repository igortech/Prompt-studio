# === Обязательная переменная ===

# JWT_SECRET: Секретный ключ для подписи JWT токенов (используется для авторизации)
JWT_SECRET="your-random-secret-key-change-this"

# === Опциональные переменные ===

# PORT: Порт для сервера (по умолчанию 3000)
PORT=3001

# Google OAuth (только если хотите вход через Google, иначе используйте обычную регистрацию)
APP_URL="http://localhost:5173"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ENCRYPTION_KEY: Дополнительный ключ для шифрования API ключей в БД (если не указан, используется JWT_SECRET)
ENCRYPTION_KEY="your-encryption-key"

# OLLAMA_ENDPOINT: URL для Ollama API (только если используете Ollama)
OLLAMA_ENDPOINT="http://localhost:11434"
